@startuml account_deletion_flow_activity
skinparam backgroundColor #FEFEFE
skinparam activityBackgroundColor #FFFFFF
skinparam activityBorderColor #333333
skinparam activityBorderThickness 2
skinparam activityFontColor #111111
skinparam activityFontSize 11
skinparam decisionBackgroundColor #FEFEFE
skinparam decisionBorderColor #333333
skinparam decisionFontColor #111111
skinparam startColor #333333
skinparam endColor #333333
skinparam swimlaneTitleBackgroundColor #FEFEFE
skinparam swimlaneBorderColor #333333
skinparam swimlaneTitleFontColor #111111
skinparam arrowColor #555555
skinparam shadowing false
skinparam activityBorderRadius 6
skinparam defaultTextAlignment left
|Utilisateur|
start
:Demande la\nsuppression;
|React|
:POST /user/delete;
|Backend|
:scheduleDeletion(id);
|MySQL|
:UPDATE users SET status='deleted',\nscheduled_deletion=DATE_ADD(NOW(),\nINTERVAL 30 DAY) WHERE id=?;
|Backend|
:HTTP 200 OK;
|React|
:Clear token + redirect;
|Utilisateur|
:Message "30 jours\npour annuler";
stop
|Utilisateur|
:Se reconnecte\npendant la grâce;
|React|
:POST /auth/login;
|Backend|
:verifyCredentials();
|Backend|
:SELECT statut +\nscheduled_deletion;
if (scheduled_deletion > NOW()\n? dans la grâce) then (Oui)
  |MySQL|
  :UPDATE users SET\nstatus='active',\nscheduled_deletion=NULL\nWHERE id=?;
  |Backend|
  :Restore + génère JWT;
  |React|
  :Stocke token;
  |Utilisateur|
  :"Bon retour !\nSuppression annulée";
else (Non)
  :Erreur 403\n"compte supprimé";
endif
stop
|CRON (quotidien)|
:Lance\nprocessPermanentDeletions();
|MySQL|
:DELETE FROM users\nWHERE status='deleted'\nAND scheduled_deletion<=NOW();
|CRON|
:Log: "X comptes\npurgés";
stop
@enduml