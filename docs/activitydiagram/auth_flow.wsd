@startuml auth_flow
skinparam backgroundColor #FEFEFE
skinparam activityBackgroundColor #FFFFFF
skinparam activityBorderColor #333333
skinparam activityBorderThickness 2
skinparam activityFontColor #111111
skinparam activityFontSize 11
skinparam decisionBackgroundColor #FEFEFE
skinparam decisionBorderColor #333333
skinparam decisionFontColor #111111
skinparam startColor #333333
skinparam endColor #333333
skinparam swimlaneTitleBackgroundColor #FEFEFE
skinparam swimlaneBorderColor #333333
skinparam swimlaneTitleFontColor #111111
skinparam arrowColor #555555
skinparam shadowing false
skinparam activityBorderRadius 6
skinparam defaultTextAlignment left
|Utilisateur|
start
:Visite /Auth;
:Voit LoginForm ou SignupForm;
if (Mode d'authentification ?) then (Login)
  :Tape email + password;
  :Click "Se connecter";
else (Signup)
  :Tape firstName + lastName;
  :Tape email + password;
  :Click "S'inscrire";
endif
|Frontend (AuthPage.jsx)|
:Toggle mode (Login/Signup);
if (Clique Login ?) then (oui)
  |Frontend (LoginForm Component)|
  :Collecte email + password;
  :Valide champs (client-side);
  
  if (Validation client OK ?) then (non)
    :Affiche erreur;
  else (oui)
    :Envoie POST /auth/login\navec { email, password };
  endif
else (Clique Signup)
  |Frontend (SignupForm Component)|
  :Collecte firstName, lastName, email, password;
  :Valide champs (client-side);
  
  if (Validation client OK ?) then (non)
    :Affiche erreur;
  else (oui)
    :Envoie POST /auth/register\navec { firstName, lastName, email, password };
  endif
endif
|Backend - AuthController|
if (Route POST /auth/register ?) then (oui)
  :Reçoit register payload;
  :Appelle AuthService\n::registerUser();
  
  |Backend - AuthService|
  :Valide email format;
  :Valide password (min 8 chars);
  :Sanitize firstName/lastName (htmlspecialchars);
  
  if (Email invalide ?) then (oui)
    :Retourne erreur 400;
    stop
  else (non)
  endif
  
  if (Password trop court ?) then (oui)
    :Retourne erreur 400;
    stop
  else (non)
  endif
  
  :Cherche user par email;
  
  if (Email déjà existe ?) then (oui)
    :Retourne erreur 409;
    stop
  else (non)
  endif
  
  :Hash password (BCRYPT);
  :Call User Model\n::create();
  
  |Backend - User Model|
  :INSERT users\n(name, email, password_hash, role, status);
  :Retourne user_id;
  
  |Backend - AuthService|
  :Retourne { id, name, email, role };
  
  |Backend - AuthController|
  :Retourne Response 201 Created;
  
else (Clique Login)
  :Reçoit login payload;
  :Appelle AuthService\n::verifyCredentials();
  
  |Backend - AuthService|
  :Cherche user par email;
  
  if (User existe ?) then (non)
    :Retourne false;
    :Retourne erreur 401;
    stop
  else (oui)
  endif
  
  :Vérifie password\n(password_verify);
  
  if (Password correct ?) then (non)
    :Retourne false;
    :Retourne erreur 401;
    stop
  else (oui)
  endif
  
  if (status == 'deleted' ?) then (oui)
    if (scheduled_deletion != NULL AND scheduled_deletion > NOW()) then (oui)
      :Restore le compte via\nrestoreAccount(user_id);
      :UPDATE users SET status='active',\nscheduled_deletion=NULL;
      :Continue login normal;
    else (non)
      :Throw Exception\n"définitivement supprimé";
      :Retourne erreur 403;
      stop
    endif
  else (non)
    if (status == 'suspended' ?) then (oui)
      if (suspended_until != NULL AND suspended_until <= NOW()) then (oui)
        :Restore le compte via\nrestoreAccount(user_id);
        :UPDATE users SET status='active',\nsuspended_until=NULL;
        :Continue login normal;
      else (non)
        if (suspended_until != NULL) then (oui)
          :Throw Exception\n"suspendu jusqu'au {date}";
        else (non)
          :Throw Exception\n"suspendu par administrateur";
        endif
        :Retourne erreur 403;
        stop
      endif
    elseif (status != 'active') then (oui)
      :Throw Exception\n"compte non actif";
      :Retourne erreur 403;
      stop
    endif
  endif
  
  :Appelle JwtService\n::generateToken();
  
  |Backend - JwtService|
  :Crée payload { user_id, role, iat, exp };
  :Encode header (base64url);
  :Encode payload (base64url);
  :Signe avec HMAC-SHA256;
  :Retourne JWT token;
  
  |Backend - AuthService|
  :Retourne { token, user };
  
  |Backend - AuthController|
  :Retourne Response 200 avec token;
endif
|Frontend (AuthContext.jsx)|
:Reçoit API response;
if (Statut success ?) then (oui)
  :Stocke token en localStorage;
  :Stocke user en localStorage;
  :Update state (isAuthenticated=true);
  :Redirect vers /;
else (non)
  :Affiche message erreur;
  :Reste sur AuthPage;
endif
|Utilisateur|
:Connecté / Inscription réussie;
:Token stocké localement;
note right
Désormais, pour les requêtes suivantes :
Authorization: Bearer <token>
↓ Middleware valide le token
end note
if (Visite page protégée ?) then (oui)
  |Frontend|
  :Lit token depuis localStorage;
  :Ajoute Authorization header;
  
  |Backend - AuthMiddleware|
  :Lit Authorization header;
  :Decode JWT avec JwtService;
  
  if (Token valide ?) then (non)
    :Retourne null;
    :Request échoue (401);
  else (oui)
    :Retourne { user_id, role };
    :Request autorisée;
  endif
else (Logout)
  |Frontend|
  :Clear localStorage;
  :Clear state;
  :Redirect /Auth;
endif
stop
@enduml
