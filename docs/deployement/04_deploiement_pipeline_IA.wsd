@startuml 04_Penguins_Deploiement_Pipeline_IA

title Penguins — Déploiement Pipeline IA (OpenRouterService)

skinparam backgroundColor #FCFCFC
skinparam defaultTextAlignment center

skinparam node {
  BorderColor #1A3A4A
  BackgroundColor #E8F4F8
  FontColor #0D2137
  FontStyle bold
}
skinparam component {
  BorderColor #1A3A4A
  BackgroundColor #FFFDE7
  FontColor #0D2137
}
skinparam cloud {
  BorderColor #4A90D9
  BackgroundColor #E3F2FD
  FontColor #0D2137
}
skinparam database {
  BorderColor #2A6A3A
  BackgroundColor #C8E6C9
  FontColor #0D2137
}
skinparam artifact {
  BorderColor #6A2A8A
  BackgroundColor #F3E5F5
  FontColor #0D2137
}
skinparam collections {
  BorderColor #2A6A3A
  BackgroundColor #C8E6C9
}

' ─── BACKEND PHP ────────────────────────────────────────────
node "Backend PHP\n<<Serveur Application>>" as backend {

  ' ── 3 DÉCLENCHEURS ──────────────────────────────────
  package "Déclencheurs (Callers)" as callers {
    component "ExploreService\n::searchByPrompt(prompt, user_id)\nPOST /explore/recommend" as explore_svc
    component "SuggestionService\n::createSuggestion(payload, file)\nPOST /suggestions/create\nPOST /admin/suggestions/create" as sug_svc
    component "ModerationService\n::moderate(content)\nappelé par ReviewService\n::submitReview() / updateReview()" as mod_svc
  }

  ' ── OPENROUTER SERVICE ──────────────────────────────
  package "OpenRouterService\n(App\\Services\\OpenRouterService)" as ai_svc_pkg {

    component "getRecommendations(prompt, toolsData)\n→ {tool_ids[], title, reasoning}" as fn_recommend
    component "evaluateToolSubmission(toolData, slimContext)\n→ {status, fixed_name, fixed_url,\n   fixed_category_id, global_rating…}" as fn_evaluate
    component "moderateComment(comment)\n→ {flagged, reason, confidence_score}" as fn_moderate

    component "attemptRequest(model, systemPrompt, userMsg)\ncURL POST — CURLOPT_TIMEOUT 90s\nCURLOPT_CONNECTTIMEOUT 5s\nHTTP 200 → extract choices[0].message.content\nstrip ```json``` fences → return string" as fn_attempt

    component "modelQueue[]\n[0] claude-opus-4-6\n[1] glm-5.1\n(Fallback: essai suivant si échec)" as model_queue
  }

  ' ── CONTEXTE DB (pour evaluate) ─────────────────────
  package "Contexte DB injecté\n(slimContext pour évaluation)" as db_ctx {
    artifact "categories[] {id, name}" as ctx_cats
    artifact "providers[] {id, name}" as ctx_provs
    artifact "tools[] existants (anti-doublon)" as ctx_tools
    artifact "models[] {id, name}" as ctx_models
  }

  ' ── RÉSULTATS STOCKÉS EN DB ─────────────────────────
  package "Résultats → Base de données" as db_results {
    component "SearchHistoryService\n::logSearch(userId, prompt,\n  title, toolIds)\n→ INSERT search_histories\n→ INSERT search_history_tools" as hist_svc

    component "SuggestionModel\n::updateFromAiValidation(id, aiData)\n→ UPDATE suggestions\n  status, fixed_name, fixed_url,\n  ai_moderation_notes, global_rating" as sug_model

    component "ReviewModel\n::updateModeration(reviewId,\n  status, aiFlagReason)\n→ UPDATE reviews\n  status = flagged/approved" as rev_model
  }
}

' ─── API EXTERNE IA ─────────────────────────────────────────
cloud "agentrouter.org\n<<External AI Gateway>>" as ai_cloud {
  node "LLM Model — claude-opus-4-6\n(priorité 1)" as llm_claude {
    component "Chat Completion\n/v1/chat/completions\nresponse_format: json_object" as chat_1
  }
  node "LLM Model — glm-5.1\n(secours si claude-opus-4-6 échoue)" as llm_glm {
    component "Chat Completion\n/v1/chat/completions\nresponse_format: json_object" as chat_2
  }
  note right of ai_cloud
    Headers envoyés :
    • Authorization: Bearer sk-GN7Z…
    • anthropic-version: 2023-06-01
    • anthropic-beta: claude-code-20250219
    • User-Agent: claude-cli/1.0.108
    • Content-Type: application/json
  end note
}

' ─── BASE DE DONNÉES ────────────────────────────────────────
database "penguin_db\n<<MySQL>>" as db {
  artifact "search_histories\nsearch_history_tools" as t_search
  artifact "suggestions\n(status, ai_notes, fixed_*)" as t_suggestions
  artifact "reviews\n(status, ai_flag_reason)" as t_reviews
}

' ─── RELATIONS ──────────────────────────────────────────────

' Callers → fonctions IA
explore_svc --> fn_recommend : prompt + toolsData[]
sug_svc --> fn_evaluate : toolData + slimContext
mod_svc --> fn_moderate : comment string

' Contexte DB → evaluate
ctx_cats --> fn_evaluate
ctx_provs --> fn_evaluate
ctx_tools --> fn_evaluate
ctx_models --> fn_evaluate

' Fonctions → attemptRequest
fn_recommend --> fn_attempt : model + systemPrompt + userMsg
fn_evaluate --> fn_attempt : model + systemPrompt + userMsg
fn_moderate --> fn_attempt : model + systemPrompt + userMsg

' attemptRequest → modelQueue → Cloud
fn_attempt --> model_queue : iterate si échec
model_queue --> llm_claude : HTTPS POST\ncURL\n(tentative 1)
model_queue --> llm_glm : HTTPS POST\ncURL\n(tentative 2, si claude échoue)

' Résultats → DB
fn_recommend --> hist_svc : {tool_ids, title, reasoning}
hist_svc --> t_search : INSERT

fn_evaluate --> sug_model : {status, fixed_name, fixed_url,\nfixed_category_id, global_rating…}
sug_model --> t_suggestions : UPDATE

fn_moderate --> rev_model : {flagged, reason, confidence_score}
rev_model --> t_reviews : UPDATE

@enduml
