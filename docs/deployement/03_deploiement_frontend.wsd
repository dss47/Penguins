@startuml 03_Penguins_Deploiement_Frontend

title Penguins — Déploiement Frontend : React SPA & Routage

skinparam backgroundColor #FCFCFC
skinparam defaultTextAlignment center

skinparam node {
  BorderColor #1A3A4A
  BackgroundColor #E8F4F8
  FontColor #0D2137
  FontStyle bold
}
skinparam package {
  BorderColor #2C6E8A
  BackgroundColor #F0F8FF
  FontColor #0D2137
}
skinparam component {
  BorderColor #1A3A4A
  BackgroundColor #FFFDE7
  FontColor #0D2137
}
skinparam artifact {
  BorderColor #6A2A8A
  BackgroundColor #F3E5F5
  FontColor #0D2137
}
skinparam storage {
  BorderColor #8A2A2A
  BackgroundColor #FFEBEE
  FontColor #0D2137
}

node "Navigateur Web\n<<Client>>" as browser {

  node "React 18 SPA\n(Vite dev: port 5173 | Prod: dist/)" as react_node {

    ' ── BOOTSTRAP ──────────────────────────────────────
    package "Bootstrap" as bootstrap_pkg {
      component "main.jsx\n(ReactDOM.createRoot)" as main
      component "App.jsx\n(Router + AuthProvider)" as app
    }

    ' ── AUTH CONTEXT ────────────────────────────────────
    package "AuthContext\n(src/context/AuthContext.jsx)" as ctx_pkg {
      component "AuthProvider\nstate: {user, token, loading}\nlogin() / logout()\nisAdmin / isManager / role" as auth_ctx
      note right of auth_ctx
        Init: lit localStorage
        Vérifie GET /user/profile
        au montage si token présent
      end note
    }

    ' ── ROUTER (react-router-dom) ───────────────────────
    package "React Router v6\n(src/routes/routes.jsx)" as router_pkg {

      package "Routes Publiques\n(Layout wrapper)" as public_routes {
        component "/ → LandingPage" as r_landing
        component "/Auth → AuthPage\n(login + signup forms)" as r_auth
        component "/MainPage → HomeSearch\n(search IA + keyword)" as r_home
        component "/tools → ToolPage\n(catalogue outils)" as r_tools
        component "/tool/:name → ToolDetailsPage\n(détails + reviews)" as r_details
        component "/Library → Library\n(favoris + rayons)" as r_library
        component "/Library/Shelf/:shelfIndex → ShelfItems" as r_shelf
        component "/ProposerOutils → ProposerOutils\n(suggestion outil)" as r_suggest
        component "/Validations → Validations\n(historique suggestions)" as r_valid
        component "/Profile → Profile\n(profil utilisateur)" as r_profile
      }

      package "Routes Admin\n(/admin — isAdmin=true)" as admin_routes {
        component "/admin/dashboard → AdminDashboard" as r_adm_dash
        component "/admin/users → AdminUsers\n(bannir, promouvoir, rétrograder)" as r_adm_users
        component "/admin/suggestions → Validations\n(approuver/rejeter)" as r_adm_sug
        component "/admin/moderation → AdminModeration\n(avis signalés)" as r_adm_mod
        component "/admin/add → AdminAddTool" as r_adm_add
        component "/admin/tools → AdminTools\n(activer/désactiver)" as r_adm_tools
        component "/admin/data → AdminEntityManager\n(catégories, providers,\nfeatures, modèles)" as r_adm_data
      }

      package "Routes Manager\n(/manager — isManager=true)" as manager_routes {
        component "/manager/dashboard → AdminDashboard" as r_mgr_dash
        component "/manager/suggestions → Validations" as r_mgr_sug
        component "/manager/moderation → AdminModeration" as r_mgr_mod
        component "/manager/add → AdminAddTool" as r_mgr_add
        component "/manager/tools → AdminTools" as r_mgr_tools
        component "/manager/data → AdminEntityManager" as r_mgr_data
        note right of manager_routes
          Même routes qu'admin
          SAUF /users (pas de gestion users)
        end note
      }
    }

    ' ── COUCHE SERVICE API ──────────────────────────────
    package "Couche Service\n(src/services/api.js)" as api_pkg {
      component "axios instance\nbaseURL: http://localhost:8000\nInterceptor request:\n  Authorization: Bearer <token>\nInterceptor response:\n  401 → clear storage + redirect /Auth" as axios_inst
    }

    ' ── ASSETS ──────────────────────────────────────────
    package "Assets\n(src/assets)" as assets_pkg {
      artifact "Titillium Web (fonts .ttf)" as font
      artifact "hero.png / icons SVG" as images
    }
  }

  ' ── LOCAL STORAGE ───────────────────────────────────
  storage "localStorage\n(persistance session)" as local_storage {
    artifact "token : <JWT string>" as ls_token
    artifact "user : <JSON user object>" as ls_user
  }
}

' ── SERVEUR BACKEND (externe) ───────────────────────────────
node "Backend PHP\n<<localhost:8000>>" as backend {
  artifact "index.php (REST API)" as api_endpoint
}

' ── RELATIONS ─────────────────────────────────────────────
main --> app
app --> auth_ctx
app --> router_pkg

auth_ctx --> local_storage : read/write\ntoken + user
auth_ctx --> axios_inst : GET /user/profile\n(vérification token)

router_pkg --> public_routes
router_pkg --> admin_routes : Navigate si isAdmin
router_pkg --> manager_routes : Navigate si isManager

axios_inst --> api_endpoint : HTTP REST\nJSON\nBearer JWT

@enduml
