@startuml 05_Penguins_Deploiement_Securite_Auth

title Penguins — Déploiement Sécurité & Authentification JWT

skinparam backgroundColor #FCFCFC
skinparam defaultTextAlignment center

skinparam node {
  BorderColor #1A3A4A
  BackgroundColor #E8F4F8
  FontColor #0D2137
  FontStyle bold
}
skinparam component {
  BorderColor #1A3A4A
  BackgroundColor #FFFDE7
  FontColor #0D2137
}
skinparam storage {
  BorderColor #8A2A2A
  BackgroundColor #FFEBEE
  FontColor #0D2137
}
skinparam database {
  BorderColor #2A6A3A
  BackgroundColor #C8E6C9
  FontColor #0D2137
}
skinparam artifact {
  BorderColor #6A2A8A
  BackgroundColor #F3E5F5
  FontColor #0D2137
}

' ─── CLIENT ─────────────────────────────────────────────────
node "Navigateur\n<<Client>>" as browser {

  package "React App" as react {
    component "AuthContext\n(AuthProvider)" as auth_ctx
    component "Axios interceptor\nrequest: ajoute\nAuthorization: Bearer <token>\nresponse 401: clear + redirect /Auth" as axios_int
    component "Forms\n(loginForm.jsx\nsignupForm.jsx)" as forms
  }

  storage "localStorage" as ls {
    artifact "token : JWT string\n(exp: 24h)" as ls_token
    artifact "user : JSON\n{id, role, email…}" as ls_user
  }
}

' ─── BACKEND SÉCURITÉ ───────────────────────────────────────
node "Backend PHP\n<<Serveur>>" as backend {

  ' ── INDEX (CORS + OPTIONS) ──────────────────────────
  package "index.php — CORS" as cors_pkg {
    component "Access-Control-Allow-Origin:\nhttp://localhost:5173\nAccess-Control-Allow-Methods:\nGET, POST, PUT, DELETE, OPTIONS\nAccess-Control-Allow-Headers:\nContent-Type, Authorization" as cors_headers
    component "OPTIONS preflight → 204\nexit immédiat" as preflight
  }

  ' ── AUTH FLOW ───────────────────────────────────────
  package "AuthController + AuthService" as auth_flow {
    component "POST /auth/register\n→ password_hash() (bcrypt)\n→ INSERT users\n→ generateToken()" as register_flow
    component "POST /auth/login\n→ findByEmail()\n→ password_verify(hash)\n→ generateToken()" as login_flow
  }

  ' ── JWT SERVICE ─────────────────────────────────────
  package "JwtService\n(App\\Utils\\JwtService)" as jwt_pkg {
    component "generateToken(payload)\nHeader: {alg: HS256, typ: JWT}\nPayload + iat + exp (+86400s)\nSignature: HMAC-SHA256(secret)\nEncodage: base64url" as jwt_gen
    component "decode(token)\nsplit('.') → 3 parties\nrecompute signature\nhash_equals() → anti timing-attack\ncheck exp > time()\nreturn payload ou null" as jwt_dec
    note right of jwt_pkg
      Secret: JWT_SECRET (env var)
      Durée token: 24h (86400s)
      Format: header.payload.signature
      Stocké: localStorage (client)
    end note
  }

  ' ── AUTH MIDDLEWARE ─────────────────────────────────
  package "AuthMiddleware" as auth_mw_pkg {
    component "authenticate()\nlit HTTP_AUTHORIZATION\nRegex: /^Bearer\\s+(.+)$/i\n→ JwtService::decode(token)\nretourne payload[] ou null" as auth_mw
  }

  ' ── ROLE MIDDLEWARE ─────────────────────────────────
  package "RoleMiddleware" as role_mw_pkg {
    component "authorize(allowedRoles[])\nVérifie role dans payload JWT\n(admin / manager / user)" as role_mw
    note right of role_mw_pkg
      Rôles définis :
      • guest → accès public
      • user → espace personnel
      • manager → dashboard (sans /users)
      • admin → accès total
    end note
  }

  ' ── PROTECTION ROUTES ───────────────────────────────
  package "Routes protégées (exemples)" as protected_routes {
    artifact "GET /user/profile → user+" as r_profile
    artifact "POST /favorites/toggle → user+" as r_fav
    artifact "GET /admin/dashboard → admin" as r_admin
    artifact "POST /admin/users/ban → admin" as r_ban
    artifact "GET /admin/suggestions → manager+" as r_sug
    artifact "POST /explore/recommend → public\n(userId optionnel si connecté)" as r_explore
  }

  ' ── PASSWORD STORAGE ────────────────────────────────
  package "Stockage mot de passe" as pwd_pkg {
    component "bcrypt (password_hash)\nPASSWORD_DEFAULT\nCoût adaptatif" as bcrypt
  }
}

' ─── BASE DE DONNÉES ────────────────────────────────────────
database "MySQL — users" as db_users {
  artifact "id, email\npassword_hash (bcrypt)\nrole (guest/user/manager/admin)\nstatus (active/banned/pending_deletion)" as users_table
}

' ─── RELATIONS ──────────────────────────────────────────────

' Client → CORS
axios_int --> cors_headers : toutes requêtes\nHTTP + Authorization

' Register / Login
forms --> register_flow : POST /auth/register\n{firstName, lastName, email, password}
forms --> login_flow : POST /auth/login\n{email, password}

register_flow --> bcrypt : password_hash()
login_flow --> bcrypt : password_verify()
bcrypt --> db_users : INSERT / SELECT

register_flow --> jwt_gen : generateToken({id, role})
login_flow --> jwt_gen : generateToken({id, role})
jwt_gen --> auth_ctx : retourne token + user
auth_ctx --> ls_token : stocke
auth_ctx --> ls_user : stocke

' Requêtes protégées
axios_int --> auth_mw : Authorization: Bearer <JWT>
auth_mw --> jwt_dec : decode(token)
jwt_dec --> role_mw : payload {id, role, exp}
role_mw --> protected_routes : accès autorisé\n(ou 401/403)

@enduml
