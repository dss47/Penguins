@startuml 02_Penguins_Deploiement_Backend

title Penguins — Déploiement Backend : Couches & Composants

skinparam backgroundColor #FCFCFC
skinparam defaultTextAlignment center
skinparam linetype ortho

skinparam node {
  BorderColor #1A3A4A
  BackgroundColor #E8F4F8
  FontColor #0D2137
  FontStyle bold
}
skinparam package {
  BorderColor #2C6E8A
  BackgroundColor #F0F8FF
  FontColor #0D2137
}
skinparam component {
  BorderColor #1A3A4A
  BackgroundColor #FFFDE7
  FontColor #0D2137
}
skinparam database {
  BorderColor #2A6A3A
  BackgroundColor #C8E6C9
  FontColor #0D2137
}
skinparam artifact {
  BorderColor #6A2A8A
  BackgroundColor #F3E5F5
  FontColor #0D2137
}

node "Serveur Backend PHP\n<<Apache + PHP-FPM 8.x>>" as server {

  ' ── ENTRÉE ──────────────────────────────────────
  package "Point d'entrée\n(backend/index.php)" as entry_pkg {
    component "Router\n(tableau $routes)" as router
    component "CORS Handler\n(Access-Control-Allow-Origin:\nlocalhost:5173)" as cors
    component "Body Parser\n(JSON / multipart/form-data)" as body_parser
  }

  ' ── MIDDLEWARE ───────────────────────────────────
  package "Middleware\n(App\\Middleware)" as mw_pkg {
    component "AuthMiddleware\nextract Bearer token\n→ JwtService::decode()" as auth_mw
    component "RoleMiddleware\nauthorize(allowedRoles[])" as role_mw
  }

  ' ── CONTROLLERS ──────────────────────────────────
  package "Controllers\n(App\\Controllers)" as ctrl_pkg {
    component "AuthController\nPOST /auth/register\nPOST /auth/login" as auth_ctrl
    component "ExploreController\nGET /landing/summary\nPOST /explore/recommend" as explore_ctrl
    component "ToolController\nGET /tools\nGET /tools/reviews\nGET /reviews/top" as tool_ctrl
    component "AdminController\n/admin/dashboard /users\n/suggestions /moderation\n/tools /data/**" as admin_ctrl
    component "ReviewController\nPOST /reviews/submit|update|delete\nGET /user/reviews" as review_ctrl
    component "FavoriteController\nGET /favorites\nPOST /favorites/toggle" as fav_ctrl
    component "ShelfController\nGET /shelves /shelves/items\nPOST /shelves/create|update|delete|toggle" as shelf_ctrl
    component "SuggestionController\nPOST /suggestions/create\nGET /suggestions/history" as sug_ctrl
    component "UserController\nGET /user/profile|stats\nPOST /user/profile/update\nGET /professions" as user_ctrl
    component "SearchHistoryController\nGET /user/search-history\nGET /user/search-history/details" as hist_ctrl
  }

  ' ── SERVICES ─────────────────────────────────────
  package "Services\n(App\\Services)" as svc_pkg {
    component "AuthService\n+ JwtService (HS256, exp 24h)" as auth_svc
    component "ExploreService\n→ OpenRouterService\n→ SearchHistoryService" as explore_svc
    component "OpenRouterService\ncURL HTTPS\nmodelQueue[claude-opus-4-6, glm-5.1]\nTimeout: 90s" as ai_svc
    component "ModerationService\n→ OpenRouterService\nbannedKeywords[]" as mod_svc
    component "SuggestionService\n→ OpenRouterService (AI validate)\n→ ToolService\n→ UploadService" as sug_svc
    component "ReviewService\n→ ModerationService" as rev_svc
    component "UploadService\nMIME check (jpg/png/webp)\nMax 5MB\n→ public/uploads/**" as upload_svc
    component "FavoriteService" as fav_svc
    component "ShelfService" as shelf_svc
    component "SearchHistoryService" as hist_svc
    component "UserService\n→ UploadService" as user_svc
    component "AdminService\n+ ToolService\n+ CategoryService\n+ ProviderService\n+ FeatureService\n+ ModelService\n+ ProfessionService" as admin_svc
  }

  ' ── MODELS ───────────────────────────────────────
  package "Models\n(App\\Models → BaseModel → PDO)" as mdl_pkg {
    component "User\nAiTool\nCategory\nProvider\nFeature\nModel\nProfession" as mdl_core
    component "Review\nSuggestion\nFavoriteItem\nShelf\nShelfItem" as mdl_user
    component "SearchHistory\nSearchHistoryTool\nToolFeatures\nToolModel" as mdl_assoc
  }

  ' ── CONFIG ───────────────────────────────────────
  package "Config\n(backend/config)" as cfg_pkg {
    component "env.php\nDB_HOST / DB_PORT / DB_NAME\nJWT_SECRET\nAI_PROVIDER_BASE_URL\nAI_PROVIDER_API_KEY" as env
    component "database.php\ndb_connection() → PDO singleton\ncharset=utf8mb4\nPDO::ERRMODE_EXCEPTION" as db_cfg
  }

  ' ── UTILS ────────────────────────────────────────
  package "Utils\n(App\\Utils)" as utils_pkg {
    component "JwtService\ngenerateToken() exp=86400s\ndecode() + hash_equals()" as jwt
    component "Response\nsuccess() / error()\njson_encode() + http_response_code()" as resp
  }

  ' ── STORAGE ──────────────────────────────────────
  artifact "public/uploads/tools/\n(ChatGPT.webp, Claude.webp…)" as uploads_tools
  artifact "public/uploads/userProfile/\n(avatars jpg)" as uploads_profiles
}

' ── BASE DE DONNÉES ───────────────────────────────
node "MySQL 8.x\n<<DB Server>>" as db_node {
  database "penguin_db" as db
}

' ── RELATIONS INTERNES ───────────────────────────
router --> cors
router --> body_parser
router --> auth_mw : vérifie Bearer JWT\nsur routes protégées
auth_mw --> role_mw
router --> ctrl_pkg : dispatch

auth_ctrl --> auth_svc
explore_ctrl --> explore_svc
explore_ctrl --> hist_svc
tool_ctrl --> mdl_core
admin_ctrl --> admin_svc
review_ctrl --> rev_svc
fav_ctrl --> fav_svc
shelf_ctrl --> shelf_svc
sug_ctrl --> sug_svc
user_ctrl --> user_svc
hist_ctrl --> hist_svc

explore_svc --> ai_svc
sug_svc --> ai_svc
rev_svc --> mod_svc
mod_svc --> ai_svc

auth_svc --> jwt
auth_svc --> mdl_core
sug_svc --> upload_svc
user_svc --> upload_svc
upload_svc --> uploads_tools
upload_svc --> uploads_profiles

mdl_core --> db_cfg
mdl_user --> db_cfg
mdl_assoc --> db_cfg
db_cfg --> env
db_cfg --> db : PDO TCP 3306

@enduml
