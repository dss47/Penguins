@startuml review_lifecycle
skinparam backgroundColor #FEFEFE
skinparam stateBackgroundColor #FFFFFF
skinparam stateBorderColor #333333
skinparam stateBorderThickness 2
skinparam stateFontColor #111111
skinparam stateFontSize 13
skinparam arrowColor #666666
skinparam arrowFontSize 11
skinparam shadowing false

state "Approuvé (approved)" as approved_state
state "Signalé (flagged)" as flagged_state

[*] --> approved_state : Utilisateur soumet\n(commentaire propre)
[*] --> flagged_state : Utilisateur soumet\n(IA détecte toxique/spam)

approved_state --> flagged_state : Utilisateur modifie\n(nouveau commentaire signalé)
flagged_state --> approved_state : Utilisateur modifie\n(nouveau commentaire propre)

flagged_state --> approved_state : Admin/Manager approuve\n(Ignorer le signalement)

flagged_state --> [*] : Admin/Manager supprime
flagged_state --> [*] : Utilisateur supprime\nson avis
approved_state --> [*] : Utilisateur supprime\nson avis

note top of approved_state
  Visible publiquement
  sur la fiche de l'outil
end note

note right of flagged_state
  Masqué du public.
  En attente de modération
  par Admin/Manager.
end note

@enduml
