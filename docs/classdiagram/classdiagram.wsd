@startuml Penguins_ClassDiagram
skinparam backgroundColor #FFFFFF
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #333333
skinparam classBorderThickness 2
skinparam classFontColor #111111
skinparam classFontSize 12
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #333333
skinparam packageFontColor #111111
skinparam arrowColor #555555
skinparam shadowing false
skinparam linetype ortho
skinparam nodeMargin 20
skinparam packageMargin 40
skinparam ranksep 60
skinparam nodesep 50
skinparam defaultTextAlignment left

!include models.wsd
!include services.wsd
!include controllers.wsd
!include middleware.wsd
!include utils.wsd
!include config.wsd
!include relationships.wsd

@enduml
