@startuml account_deletion_flow
skinparam maxMessageSize 200


actor "User" as user
participant "React UI" as react
participant "UserController" as user_ctrl
participant "AuthController" as auth_ctrl
participant "UserService" as service
participant "User (Model)" as model
participant "Response.php" as res
database "MySQL (users)" as db
actor "Cron Job\n(Serveur)" as cron


== Phase 1: Demande de suppression (Soft Delete) ==

user -> react : Clicks "Supprimer mon compte"
activate react
  react -> user_ctrl : POST /api/user/delete
  activate user_ctrl
    user_ctrl -> service : scheduleDeletion(user_id)
    activate service
      
      service -> model : suspendAccount(user_id, +30 days)
      activate model
        model -> db : UPDATE users \nSET status = 'suspended', \ndeletion_scheduled_at = DATE_ADD(NOW(), INTERVAL 30 DAY) \nWHERE id = ?
        activate db
          db --> model : Success
        deactivate db
        model --> service : Success
      deactivate model
      
      service --> user_ctrl : Returns Success
    deactivate service
    
    user_ctrl -> res : formatSuccess({message: "Account suspended for 30 days"})
    activate res
      res --> user_ctrl : JSON String
    deactivate res
    
    user_ctrl --> react : HTTP 200 OK
  deactivate user_ctrl
  

  react -> react : clears localStorage (Token)
  react --> user : Redirects to Login\nShows "Compte désactivé pour 30 jours."
deactivate react


== Phase 2: Annulation (Connexion dans les 30 jours) ==

user -> react : Logs back in (Changes mind)
activate react
  react -> auth_ctrl : POST /api/login\n{email, password}
  activate auth_ctrl
    auth_ctrl -> service : verifyCredentials(email, password)
    activate service
      
      service -> model : findByEmail(email)
      activate model
        model -> db : SELECT * FROM users WHERE email = ?
        db --> model : Returns User Data
        model --> service : User Object
      deactivate model
      
      note right of service: System notices the account is suspended\nBUT has a scheduled deletion date!
      
      alt status == 'suspended' AND deletion_scheduled_at IS NOT NULL
          

          service -> model : restoreAccount(user_id)
          activate model
            model -> db : UPDATE users \nSET status = 'active', \ndeletion_scheduled_at = NULL \nWHERE id = ?
            db --> model : Success
            model --> service : Restored
          deactivate model
          
      end
      
      service -> service : Generate JWT Token
      service --> auth_ctrl : Returns Token & User Data
    deactivate service
    
    auth_ctrl -> res : formatSuccess({token, message: "Welcome back"})
    auth_ctrl --> react : HTTP 200 OK
  deactivate auth_ctrl
  
  react --> user : Shows "Bon retour ! Suppression annulée."
deactivate react


== Phase 3: Suppression Définitive (Le Cron Job) ==

note over cron: Runs automatically every night at 00:00
cron -> service : CLI Command: executeDailyCleanup()
activate service
  
  service -> model : processPermanentDeletions()
  activate model
    
    note right of model: Finds everyone whose 30 days are up
    model -> db : UPDATE users \nSET status = 'deleted' \nWHERE status = 'suspended' \nAND deletion_scheduled_at <= NOW()
    activate db
      db --> model : Returns number of rows affected
    deactivate db
    
    model --> service : Success
  deactivate model
  
  service --> cron : Logs "Cleanup complete: X accounts deleted."
deactivate service

@enduml