@startuml s_inscrire
skinparam backgroundColor #FEFEFE
skinparam participantBackgroundColor #FFFFFF
skinparam participantBorderColor #333333
skinparam participantFontColor #111111
skinparam participantFontSize 12
skinparam actorBackgroundColor #FFFFFF
skinparam actorBorderColor #333333
skinparam actorFontColor #111111
skinparam arrowColor #555555
skinparam lifeLineBackgroundColor #FEFEFE
skinparam shadowing false
skinparam maxMessageSize 200

actor "Guest" as guest
participant "register form" as sign_up
participant "AuthController" as auth_controller
participant "AuthService" as auth_service
participant "User (Model)" as model
participant "Response.php (Util)" as res
database "MySQL (users)" as db

guest -> sign_up : Types infos, clicks "S'inscrire"
activate sign_up
sign_up -> auth_controller : POST /auth/register\n{firstName, lastName, email, password}
activate auth_controller
auth_controller -> auth_service : registerUser(name, email, password)
activate auth_service

auth_service -> model : findByEmail(email)
activate model
model -> db : SELECT * FROM users WHERE email = ?
activate db
db --> model : Returns row (or empty)
deactivate db
model --> auth_service : Returns User object (or null)
deactivate model

alt Email n'existe pas (Succès)
    
    auth_service -> model : new User(firstName, lastName, email, hashed_pw, 'user')
    activate model
    model -> db : INSERT INTO users (first_name, last_name, email, password_hash, role)\nVALUES (?, ?, ?, ?, 'user')
    activate db
    db --> model : Returns new user_id
    deactivate db
    model --> auth_service : Returns User object
    deactivate model
    
    auth_service -> auth_service : Generates JWT Token
    auth_service --> auth_controller : Returns Token & User object
    
    auth_controller -> res : created({token, user})
    activate res
    res --> auth_controller : JSON String
    deactivate res
    
    auth_controller --> sign_up : HTTP 201 Created\nJSON
    sign_up -> sign_up : Saves Token
    sign_up --> guest : Redirects to Espace Personnel
    
else Email existe déjà (Échec)
    
    auth_service --> auth_controller : Returns Error
    
    auth_controller -> res : error("Email already in use", 409)
    activate res
    res --> auth_controller : JSON String
    deactivate res
    
    auth_controller --> sign_up : HTTP 409 Conflict\nJSON
    sign_up --> guest : Displays "Cet email est déjà utilisé" message
    
end

deactivate auth_service
deactivate auth_controller
deactivate sign_up
@enduml