@startuml explore_browse
skinparam backgroundColor #FEFEFE
skinparam participantBackgroundColor #FFFFFF
skinparam participantBorderColor #333333
skinparam participantFontColor #111111
skinparam participantFontSize 12
skinparam actorBackgroundColor #FFFFFF
skinparam actorBorderColor #333333
skinparam actorFontColor #111111
skinparam arrowColor #555555
skinparam lifeLineBackgroundColor #FEFEFE
skinparam shadowing false
skinparam maxMessageSize 200

actor "Visitor/User" as user
participant "React UI\n(Home & Explore)" as react
participant "ToolController" as tool_ctrl
participant "ExploreController" as explore_ctrl
participant "ToolService" as tool_svc
participant "ExploreService" as explore_svc
participant "Models\n(Category, Provider, AiTool)" as model
participant "Response.php" as res
database "MySQL" as db


== 1. Landing Page Summary ==

user -> react : Visits landing page
activate react
  react -> explore_ctrl : GET /landing/summary
  activate explore_ctrl
    explore_ctrl -> explore_svc : landingSummary()
    activate explore_svc
      explore_svc -> model : countByStatus('active')
      activate model
        model -> db : SELECT COUNT(*), category_id FROM ai_tools\nWHERE status='active' GROUP BY category_id
        activate db
          db --> model : Stats per category
        deactivate db
        model --> explore_svc : Aggregate statistics
      deactivate model
      
      explore_svc -> model : fetchTopRated(limit=6)
      activate model
        model -> db : SELECT t.*, AVG(r.rating) as avg_rating\nFROM ai_tools t JOIN reviews r ON t.id = r.tool_id\nWHERE t.status='active' GROUP BY t.id\nORDER BY avg_rating DESC LIMIT 6
        activate db
          db --> model : Top rated tools
        deactivate db
        model --> explore_svc : Top tools array
      deactivate model
      
      explore_svc --> explore_ctrl : Returns stats + top tools
    deactivate explore_svc
    
    explore_ctrl -> res : success(data)
    activate res
      res --> explore_ctrl : JSON String
    deactivate res
    
    explore_ctrl --> react : HTTP 200 OK
  deactivate explore_ctrl
  
  react --> user : Displays stats, featured tools, category cards
deactivate react


== 2. Browse All Tools ==

user -> react : Clicks "Explorer" in navigation
activate react
  react -> tool_ctrl : GET /tools
  activate tool_ctrl
    tool_ctrl -> tool_svc : listPublicTools()
    activate tool_svc
      tool_svc -> model : all()
      activate model
        model -> db : SELECT t.*, c.name, p.name\nFROM ai_tools t\nLEFT JOIN categories c ON t.category_id = c.id\nLEFT JOIN providers p ON t.provider_id = p.id\nWHERE t.status = 'active'
        activate db
          db --> model : Array of tools
        deactivate db
        model --> tool_svc : Tools array
      deactivate model
      
      tool_svc -> model : findFeaturesByToolId()\n(loops each tool)
      activate model
        model -> db : SELECT f.name FROM features f\nJOIN tool_features tf ON f.id = tf.feature_id\nWHERE tf.tool_id = ?
        activate db
          db --> model : Feature names per tool
        deactivate db
        model --> tool_svc : Features per tool
      deactivate model
      
      tool_svc --> tool_ctrl : Tools with features
    deactivate tool_svc
    
    tool_ctrl -> res : success(tools)
    tool_ctrl --> react : HTTP 200 OK
  deactivate tool_ctrl
  
  react --> user : Shows all active tool cards\n(default explore view)
deactivate react


== 3. Tool Detail View ==

user -> react : Clicks on a tool card
activate react
  react -> tool_ctrl : GET /tools?name=ToolName
  activate tool_ctrl
    tool_ctrl -> tool_svc : getPublicToolByName("ToolName")
    activate tool_svc
      tool_svc -> model : findByName("ToolName")
      activate model
        model -> db : SELECT t.* FROM ai_tools t\nWHERE t.name = ? AND t.status = 'active'
        activate db
          db --> model : Tool row
        deactivate db
        model --> tool_svc : Tool object
      deactivate model
      
      tool_svc -> model : findFeaturesByToolId(tool_id)
      activate model
        model -> db : SELECT f.name FROM features f\nJOIN tool_features tf ON f.id = tf.feature_id\nWHERE tf.tool_id = ?
        activate db
          db --> model : Feature list
        deactivate db
        model --> tool_svc : Features array
      deactivate model
      
      tool_svc -> model : findModelsByToolId(tool_id)
      activate model
        model -> db : SELECT m.name FROM models m\nJOIN tool_models tm ON m.id = tm.model_id\nWHERE tm.tool_id = ?
        activate db
          db --> model : Model list
        deactivate db
        model --> tool_svc : Models array
      deactivate model
      
      tool_svc -> tool_svc : findSimilarTools(category_id, tool_id)
      
      tool_svc --> tool_ctrl : Tool details + features + models + similar
    deactivate tool_svc
    
    tool_ctrl -> res : success({data: tool})
    tool_ctrl --> react : HTTP 200 OK
  deactivate tool_ctrl
  
  react --> user : Shows full tool page\n(description, features, models, similar tools)
deactivate react

@enduml
