@startuml ai_semantic_search
skinparam backgroundColor #FEFEFE
skinparam participantBackgroundColor #FFFFFF
skinparam participantBorderColor #333333
skinparam participantFontColor #111111
skinparam participantFontSize 12
skinparam actorBackgroundColor #FFFFFF
skinparam actorBorderColor #333333
skinparam actorFontColor #111111
skinparam arrowColor #555555
skinparam lifeLineBackgroundColor #FEFEFE
skinparam shadowing false
skinparam maxMessageSize 200

actor "User" as user
participant "React UI\n(Search & Sidebar)" as react
participant "ExploreController" as explore_ctrl
participant "ExploreService" as service
participant "OpenRouterService\n(AI Engine)" as ai
participant "SearchHistoryController" as history_ctrl
participant "SearchHistoryService" as history_svc
participant "Models\n(Category, AiTool)" as model
participant "Response.php" as res
database "MySQL" as db


== Phase 1: AI Prompt Search (Recommendation) ==

user -> react : Types "I need to make a podcast", hits Enter
activate react
  
  react -> explore_ctrl : POST /explore/recommend\n{prompt: "I need to make a podcast"}
  activate explore_ctrl
    explore_ctrl -> service : searchByPrompt(prompt, user_id)
    activate service
      
      service -> ai : getRecommendations(prompt, toolsData)
      activate ai
        ai --> service : JSON: {\n  title: "Podcast Creation",\n  toolIds: [1, 5, 12]\n}
      deactivate ai
      
      service -> model : findActiveByIds([1, 5, 12])
      activate model
        model -> db : SELECT * FROM ai_tools WHERE id IN (...) AND status='active'
        activate db
          db --> model : Array of matching tools
        deactivate db
        model --> service : Tools Array
      deactivate model
      
      service -> history_svc : logSearch(user_id, prompt, title, toolIds)
      activate history_svc
        history_svc -> model : logSearch(prompt, title, user_id)
        activate model
          model -> db : INSERT INTO search_histories (prompt, title, user_id)
          activate db
            db --> model : Returns new_search_id
          deactivate db
          
          model -> db : INSERT INTO search_history_tools (search_id, tool_id)
          activate db
            db --> model : Success
          deactivate db
          model --> history_svc : History Object
        deactivate model
        history_svc --> service : History Object
      deactivate history_svc
      
      service --> explore_ctrl : Returns {history_item, tools}
    deactivate service
    
    explore_ctrl -> res : success(data)
    activate res
      res --> explore_ctrl : JSON String
    deactivate res
    
    explore_ctrl --> react : HTTP 200 OK
  deactivate explore_ctrl
  
  react -> react : Prepends "Podcast Creation" to Sidebar History
  react --> user : Displays the recommended tools!
deactivate react


== Phase 2: Reloading from Sidebar History ==

user -> react : Clicks "Podcast Creation" from Sidebar History
activate react
  
  react -> history_ctrl : GET /user/search-history/details?id=55
  activate history_ctrl
    history_ctrl -> history_svc : getSearchDetails(search_id=55, user_id)
    activate history_svc
      
      history_svc -> model : fetchToolsByHistoryId(55)
      activate model
        
        model -> db : SELECT t.* FROM ai_tools t\nJOIN search_history_tools sht ON t.id = sht.tool_id\nWHERE sht.search_id = 55 AND t.status = 'active'
        activate db
          db --> model : Array of matching tools
        deactivate db
        
        model --> history_svc : Tools Array
      deactivate model
      
      history_svc --> history_ctrl : Returns Tools Array
    deactivate history_svc
    
    history_ctrl -> res : success(Tools Array)
    activate res
      res --> history_ctrl : JSON String
    deactivate res
    
    history_ctrl --> react : HTTP 200 OK
  deactivate history_ctrl
  
  react --> user : Displays the exact same tools again instantly!
deactivate react

@enduml
