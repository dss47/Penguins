@startuml review_moderation_pipeline
skinparam maxMessageSize 200

' --- PARTICIPANTS ---
actor "Regular User" as user
actor "Admin" as admin
participant "React UI" as react
participant "Auth & Role\nMiddleware" as auth
participant "ReviewController" as review_ctrl
participant "AdminController" as admin_ctrl
participant "ReviewService" as service
participant "AI Moderatio" as ai
participant "Models\n(Review & User)" as model
participant "Response.php" as res
database "MySQL" as db


== Phase 1: Review Submission & AI Filter ==

user -> react : Submits Rating (5) & Comment
activate react
  
  react -> auth : POST /reviews/submit\n{tool_id, rating, comment}
  activate auth
    auth -> review_ctrl : Forward Request (Inject user_id)
    activate review_ctrl
      
      review_ctrl -> service : submitReview(user_id, data)
      activate service
        
        service -> ai : moderateComment(comment)
        activate ai
          ai --> service : Returns JSON {flagged: true, categories: ["profanity"]}
        deactivate ai
        
        alt Commentaire est Toxique/Spam (Flagged)
            
            service -> model : saveReview(data, status='flagged')
            activate model
              model -> db : INSERT INTO reviews (..., status='flagged')
              db --> model : Returns new_review_id
            deactivate model
            
            service --> review_ctrl : Returns "Held for moderation"
            
            review_ctrl -> res : created({message: "En attente de modération"})
            activate res
              res --> review_ctrl : JSON String
            deactivate res
            
            review_ctrl --> react : HTTP 201 Created (Pending Warning)
            react --> user : Shows "Votre avis est en cours de vérification"
            
        else Commentaire est Propre (Approved)
            
            note right of service: If the AI returned {flagged: false},\nthe Model inserts it as status='approved'\nand it immediately appears on the site.
            
        end
        
      deactivate service
    deactivate review_ctrl
  deactivate auth
deactivate react


== Phase 2: Admin Moderation & User Ban ==

admin -> react : Reviews "Flagged" tab in Dashboard
activate react
  
  admin -> react : Clicks "Ban User" on an offending user
  react -> auth : POST /admin/users/ban\n{id: 12}
  activate auth
    
    alt User Role != 'admin'
        auth --> react : HTTP 403 Forbidden
    else User Role == 'admin'
        
        auth -> admin_ctrl : Forward Request
        activate admin_ctrl
          
          admin_ctrl -> service : updateUserStatus(id, 'suspended')
          activate service
            
            service -> model : updateStatus(user_id, 'suspended')
            activate model
              model -> db : UPDATE users SET status = 'suspended' WHERE id = ?
              db --> model : Success
            deactivate model
            
            service --> admin_ctrl : Returns Success
          deactivate service
          
          admin_ctrl -> res : success({action: "user_suspended"})
          activate res
            res --> admin_ctrl : JSON String
          deactivate res
          
          admin_ctrl --> react : HTTP 200 OK
        deactivate admin_ctrl
        
    end ' End of RBAC Check
  deactivate auth
  
  react -> react : Removes review from the list
  react --> admin : Shows "Utilisateur banni avec succès"
deactivate react

@enduml