@startuml favorites
skinparam maxMessageSize 150

actor "User" as user
participant "UI_favorite" as react
participant "AuthMiddleware" as auth 
participant "FavoriteController" as controller 
participant "FavoriteService" as service 
participant "FavoriteItem (Model)" as model
participant "Response.php (Util)" as res

database "MySQL (favorite_items)" as db

user -> react : Clicks "Heart/Favorite" icon on a Tool
activate react
  react -> auth : POST /favorites/toggle\n{tool_id} (Sends JWT Token)
  activate auth
  
    alt Token Invalide ou Absent
        auth --> react : HTTP 401 Unauthorized
        react --> user : Redirects to Login Page
    else Token Valide (Logged In)
        
        auth -> controller : Forward Request\n(Injects user_id)
        activate controller
        deactivate auth
        
        controller -> service : toggleFavorite(user_id, tool_id)
        activate service
          service -> model : isFavorited(user_id, tool_id)
          activate model
            model -> db : SELECT 1 FROM favorite_items\nWHERE user_id = ? AND tool_id = ?
            activate db
              db --> model : true/false
            deactivate db
            model --> service : boolean
          deactivate model
          
          alt Outil est déjà dans les favoris
              service -> model : remove(user_id, tool_id)
              activate model
                model -> db : DELETE FROM favorite_items\nWHERE user_id = ? AND tool_id = ?
                activate db
                  db --> model : Deleted
                deactivate db
                model --> service : action: "removed"
              deactivate model
              
          else Outil n'est pas dans les favoris
              service -> model : add(user_id, tool_id)
              activate model
                model -> db : INSERT INTO favorite_items (user_id, tool_id)\nVALUES (?, ?)
                activate db
                  db --> model : Inserted
                deactivate db
                model --> service : action: "added"
              deactivate model
          end
          
          service --> controller : Returns action ("added/removed")
        deactivate service
        controller -> res : success({action})
        activate res
          res --> controller : Standardized JSON String
        deactivate res
        
        controller --> react : HTTP 200 OK\nJSON: {success: true, data: {action: "added/removed"}}
        deactivate controller
    end
  
  react -> react : Updates UI State\n(Heart turns red or empty)
  react --> user : Sees visual confirmation
deactivate react

@enduml